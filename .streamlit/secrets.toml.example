# Kopiér til .streamlit/secrets.toml (lokalt) eller indsæt under "Secrets" i Streamlit Cloud.

# AI (opskrifter, fortolkning af varer og billeder). Hent en nøgle på https://aistudio.google.com/apikey
GEMINI_API_KEY = "..."
# GEMINI_MODEL = "gemini-flash-latest"   # grundigere, men langsommere og dyrere end standarden (flash-lite)

# Adgangskode til appen. Anbefales, da appen indeholder familiens allergier.
APP_PASSWORD = "..."

# Varig lagring i Supabase (se supabase/schema.sql). Uden disse gemmes der i en lokal fil.
